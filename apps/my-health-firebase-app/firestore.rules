rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Publiczny katalog badań - tylko odczyt
    match /tests-catalog/{testId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Rekomendacje badań - tylko odczyt
    match /tests-recommendations/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Profile użytkowników - tylko właściciel może odczytywać i modyfikować
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Wyniki badań (subkolekcja) - tylko właściciel
      match /results/{resultId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Harmonogram badań (subkolekcja) - tylko właściciel  
      match /schedules/{scheduleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Raporty AI (subkolekcja) - tylko właściciel
      match /aiReports/{reportId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Sesje badań (subkolekcja) - tylko właściciel
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
